<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/mainPage.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="d-flex flex-column min-vh-100">
  <%- include("../partials/admin-header.ejs") %>

    <div class="toast-container position-fixed top-0 end-0 p-3">
      <div id="successToast" class="toast text-bg-success border-0" role="alert">
        <div class="d-flex">
          <div class="toast-body" id="successToastBody">
            failed to delete
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
      </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3">
      <div id="failToast" class="toast text-bg-danger border-0" role="alert">
        <div class="d-flex">
          <div class="toast-body" id="failToastBody">
            failed to delete
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
      </div>
    </div>

    <main class="flex-fill ">
      <div class="container d-flex justify-content-center">

        <div class="w-25 my-4">
          <form id="book-form" enctype="multipart/form-data" class="form d-flex flex-column justify-content-between gap-2">
            <div class="d-flex flex-column">
              <label for="title">Title</label>
              <input id="title" name="title" placeholder="Title" class="form-control" type="text" required>
            </div>

            <div class="d-flex flex-column">
              <label for="author">Author</label>
              <input id="author" name="author" placeholder="Author" class="form-control" type="text" required>
            </div>

            <div class="d-flex flex-column">
              <label for="year">Year</label>
              <input id="year" name="year" placeholder="Year" class="form-control" type="number" required>
            </div>

            <div class="d-flex flex-column">
              <label for="description">Description</label>
              <textarea name="description" id="description" placeholder="Description" class="form-control" rows="6"
                required></textarea>
            </div>

            <div class="d-flex flex-column">
              <label for="image">Image of book cover</label>
              <input id="image" name="image" class="form-control" type="file">
            </div>

            <div class="d-flex flex-column">
              <label for="pagesCount">Pages count</label>
              <input id="pagesCount" name="pagesCount" placeholder="Pages count" class="form-control" type="number"
                required>
            </div>

            <div class="d-flex flex-column">
              <label for="rating">Rating</label>
              <input id="rating" name="rating" placeholder="Rating" class="form-control" type="text">
            </div>

            <input class="btn btn-secondary" type="submit" value="Add new book">
          </form>
        </div>

      </div>
    </main>

    <%- include("../partials/footer.ejs") %>

    <script src="/js/addBook.js"></script>
</body>

</html>