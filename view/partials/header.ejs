<header>
  <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="javascript:void(0)">Book WB</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mynavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mynavbar">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link" href="javascript:void(0)">Popular</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="javascript:void(0)">New</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="javascript:void(0)">Best</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <div class="my-1 pb-1 shadow-sm">
    <div class="d-flex justify-content-center">
      <div class=" d-flex flex-row justify-content-center">

        <button class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#filters">Advansed search</button>

        <form class="d-flex flex-row">
          <input class="form-control mx-3" type="text" placeholder="Search">
          <button class="btn btn-secondary" type="button">Search</button>
        </form>
      </div>
    </div>

    <div class="d-flex justify-content-center">
      <div id="filters" class="collapse">
        <form action="" class="d-flex flex-row form justify-content-around">
          <div class="d-flex flex-column justify-content-between me-5 mt-4">
            <input type="text" placeholder="Title" class="form-control">
            <input type="text" placeholder="Author" class="form-control">
            <input type="number" placeholder="Year" class="form-control">
          </div>

          <div class="d-flex flex-column justify-content-between">
            <div class="d-flex flex-column">
              <label for="sort-by" class="label">Sort by</label>
              <select name="sort-by" id="#sort-by" class="form-select">
                <option value="" class="form-control">Popularity</option>
                <option value="" class="form-control">Rating</option>
                <option value="" class="form-control">Title</option>
                <option value="" class="form-control">Year</option>
                <option value="" class="form-control">Pages count</option>
              </select>
            </div>

            <div class="d-flex flex-column mt-2 mb-4">
              <label for="#sort-direction" class="label">Sort order</label>
              <select name="" id="sort-direction" class="form-select">
                <option value="desc" class="form-control">From bigger to smaller</option>
                <option value="asc" class="form-control">From smaller to bigger</option>
              </select>
            </div>

            <input type="submit" value="Advansed search" class="btn btn-secondary">
          </div>
        </form>
      </div>

    </div>
  </div>
</header>